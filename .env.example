# Copy this file to .env and fill in your key
# NEVER commit .env to GitHub — it is in .gitignore

# Option 1: Real Anthropic API key (pay-per-token)
# Get yours at: console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option 2: Mock mode (no key required — runs full pipeline with realistic outputs)
# MOCK_MODE=1
